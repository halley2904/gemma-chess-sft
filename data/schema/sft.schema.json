{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemma Chess SFT record",
  "type": "object",
  "required": [
    "sample_id",
    "source",
    "fen",
    "target_move_uci",
    "split",
    "messages"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "human_lichess",
        "chessbench",
        "stockfish_generated",
        "illustrative"
      ]
    },
    "game_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fen": {
      "type": "string"
    },
    "target_move_uci": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "engine_eval_cp": {
      "type": [
        "integer",
        "null"
      ]
    },
    "engine_depth": {
      "type": [
        "integer",
        "null"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "illustrative"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
